{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Vendor Portal V2 \uc0ac\uc6a9\uc790 \ub9e4\ub274\uc5bc","text":"<p>\uc7a5\uae08\uc0c1\uc120 Vendor Portal V2 \uc758 \ud654\uba74 \uc0ac\uc6a9 \uc548\ub0b4\uc785\ub2c8\ub2e4. \uc5c5\ubb34 \ub2f4\ub2f9\uc790\uac00 \ub85c\uadf8\uc778\ubd80\ud130 \uac01 \uc5c5\ubb34 \ud654\uba74 \uc0ac\uc6a9\uae4c\uc9c0 \ub530\ub77c \ud560 \uc218 \uc788\ub3c4\ub85d \uad6c\uc131\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\uc774 \ub9e4\ub274\uc5bc \ubcf4\ub294 \ubc95","text":"<ul> <li>\uc2dc\uc791\ud558\uae30 \u2014 \ub85c\uadf8\uc778, \ud654\uba74 \uad6c\uc131, \uba54\ub274/\ud0ed \uc0ac\uc6a9\ubc95</li> <li>\uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95 \u2014 \uac80\uc0c9\u00b7\uadf8\ub9ac\ub4dc\u00b7\uc5d1\uc140\u00b7\ud30c\uc77c\ucca8\ubd80 \ub4f1 \ubaa8\ub4e0 \ud654\uba74\uc5d0 \uacf5\ud1b5\uc778 \uc870\uc791</li> <li>\uc5c5\ubb34 \uba54\ub274 \u2014 EIR, \ucee8\ud14c\uc774\ub108 \uc218\ub9ac, \uc778\ub79c\ub4dc \ud53c\ub354 \uc6b4\uc1a1 \ub4f1 \uc5c5\ubb34\ubcc4 \uc548\ub0b4</li> <li>\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38</li> </ul> <p>\ud654\uba74 \uba85\uce6d \uc548\ub0b4</p> <p>\uba54\ub274\uba85\u00b7\ud654\uba74 \uc81c\ubaa9\u00b7\ud56d\ubaa9\uba85\uc740 \uc2e4\uc81c \ud654\uba74(\ub85c\uadf8\uc778 \ud6c4 \uc88c\uce21 \uba54\ub274)\uc774 \uae30\uc900\uc785\ub2c8\ub2e4. \uad8c\ud55c\uc5d0 \ub530\ub77c \ubcf4\uc774\ub294 \uba54\ub274\uac00 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <p>\ubb38\uc11c \uad00\ub9ac \uc815\ucc45(\uae30\uc5ec\uc790\uc6a9)</p> <p>\uc774 \ub9e4\ub274\uc5bc\uc740 <code>Vendor-Portal-V2-Frontend-docs</code> \uacf5\uac1c \ub808\ud3ec\ub85c \ubc1c\ud589\ub429\ub2c8\ub2e4.</p> <ul> <li>\uc0ac\ub0b4 \uc804\uc6a9 \uc815\ubcf4 \uae08\uc9c0 \u2014 \ub0b4\ubd80 IP\u00b7\ud638\uc2a4\ud2b8\uba85\u00b7\uacc4\uc815\u00b7\uc2e4\uc6b4\uc601 \ubb38\uc11c(\ubc0f \ubbfc\uac10\uc815\ubcf4\uac00 \ub2f4\uae34 \uc2a4\ud06c\ub9b0\uc0f7)\ub97c \uacf5\uac1c \ub9e4\ub274\uc5bc\uc5d0 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.</li> <li>\ud55c\uad6d\uc5b4 \u00b7 MkDocs Material \u2014 \ub9e4\ub274\uc5bc\uc740 \ud55c\uad6d\uc5b4\ub85c \uc791\uc131\ud558\uace0 \uc870\uc9c1 \ud45c\uc900 \ubb38\uc11c \ub3c4\uad6c\uc778 MkDocs Material(<code>theme: material</code>, <code>language: ko</code>)\uc744 \ub530\ub985\ub2c8\ub2e4.</li> </ul>"},{"location":"#_2","title":"\ube60\ub978 \uc2dc\uc791","text":"<ol> <li>\ube0c\ub77c\uc6b0\uc800\ub85c \ud3ec\ud138\uc5d0 \uc811\uc18d\ud574 \uc0ac\ubc88/\ube44\ubc00\ubc88\ud638\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4.</li> <li>\ud654\uba74 \uc67c\ucabd \uba54\ub274\uc5d0\uc11c \uc5c5\ubb34\ub97c \uc120\ud0dd\ud558\uba74, \ud0ed\uc73c\ub85c \ud654\uba74\uc774 \uc5f4\ub9bd\ub2c8\ub2e4.</li> <li>\ub300\ubd80\ubd84\uc758 \ud654\uba74\uc740 \uc704\ucabd \uac80\uc0c9 \uc870\uac74 \u2192 [\uc870\ud68c] \u2192 \uc544\ub798 \ud45c(\uadf8\ub9ac\ub4dc) \ud750\ub984\uc785\ub2c8\ub2e4.</li> <li>\ud45c\uc5d0\uc11c \ub370\uc774\ud130\ub97c \ud3b8\uc9d1/\ucd94\uac00/\uc0ad\uc81c\ud55c \ub4a4 [\uc800\uc7a5] \uc73c\ub85c \ubc18\uc601\ud569\ub2c8\ub2e4.</li> </ol> <p>\uc790\uc138\ud55c \uacf5\ud1b5 \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95\uc744 \ucc38\uace0\ud558\uc138\uc694.</p>"},{"location":"common-ui/","title":"\uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95","text":"<p>\ub300\ubd80\ubd84\uc758 \uc5c5\ubb34 \ud654\uba74\uc740 \ub3d9\uc77c\ud55c \uc870\uc791 \ubc29\uc2dd\uc744 \ub530\ub985\ub2c8\ub2e4. \ud55c \ubc88 \uc775\ud600\ub450\uba74 \ubaa8\ub4e0 \ud654\uba74\uc5d0 \uadf8\ub300\ub85c \uc801\uc6a9\ub429\ub2c8\ub2e4.</p>"},{"location":"common-ui/#_2","title":"\uae30\ubcf8 \ud750\ub984: \uc870\ud68c \u2192 \ud3b8\uc9d1 \u2192 \uc800\uc7a5","text":"<pre><code>\u2460 \uac80\uc0c9 \uc870\uac74 \uc785\ub825  \u2192  \u2461 [\uc870\ud68c]  \u2192  \u2462 \ud45c(\uadf8\ub9ac\ub4dc)\uc5d0\uc11c \ud655\uc778/\ud3b8\uc9d1  \u2192  \u2463 [\uc800\uc7a5]\n</code></pre> <ul> <li>[\uc870\ud68c] \u2014 \uc785\ub825\ud55c \uc870\uac74\uc73c\ub85c \ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc635\ub2c8\ub2e4.</li> <li>[\ucd08\uae30\ud654] \u2014 \uac80\uc0c9 \uc870\uac74\uc744 \ube44\uc6c1\ub2c8\ub2e4.</li> <li>[\uc800\uc7a5] \u2014 \ud45c\uc5d0\uc11c \ucd94\uac00/\uc218\uc815/\uc0ad\uc81c\ud55c \ub0b4\uc6a9\uc744 \uc11c\ubc84\uc5d0 \ubc18\uc601\ud569\ub2c8\ub2e4.</li> <li>\ud654\uba74\uc5d0 \ub530\ub77c [\ubc1c\ud589] / [\uc804\uc1a1] / [\ud655\uc815] \uac19\uc740 \uc5c5\ubb34 \uc804\uc6a9 \ubc84\ud2bc\uc774 \uc788\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"common-ui/#_3","title":"\uac80\uc0c9 \uc870\uac74","text":"<ul> <li>\ub0a0\uc9dc: \ub2ec\ub825 \uc544\uc774\ucf58\uc73c\ub85c \uae30\uac04\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.</li> <li>\ucf54\ub4dc \uc120\ud0dd: \ub4dc\ub86d\ub2e4\uc6b4\uc5d0\uc11c \ud56d\ubaa9\uc744 \uace0\ub985\ub2c8\ub2e4(\uc120\uc0ac/\ud56d\ub9cc/\ud1b5\ud654 \ub4f1 \uacf5\ud1b5\ucf54\ub4dc).</li> <li>\uc5ec\ub7ec \uc870\uac74\uc740 AND(\ubaa8\ub450 \ub9cc\uc871)\ub85c \uc801\uc6a9\ub429\ub2c8\ub2e4.</li> </ul>"},{"location":"common-ui/#_4","title":"\ud45c(\uadf8\ub9ac\ub4dc) \ub2e4\ub8e8\uae30","text":"<p>\ubaa9\ub85d\uc740 ag-grid \ud45c\ub85c \ud45c\uc2dc\ub418\uba70 \ub2e4\uc74c\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4.</p> <ul> <li>\uc815\ub82c: \uc5f4 \uba38\ub9ac\uae00 \ud074\ub9ad(\ub2e4\uc2dc \ud074\ub9ad\ud558\uba74 \uc5ed\uc21c).</li> <li>\ud544\ud130: \uc5f4 \uba38\ub9ac\uae00\uc758 \ud544\ud130\ub85c \ud45c \uc548\uc5d0\uc11c \ucd94\uac00\ub85c \uac78\ub7ec\ubcf4\uae30.</li> <li>\uc5f4 \ub108\ube44/\uc21c\uc11c: \uba38\ub9ac\uae00 \uacbd\uacc4 \ub4dc\ub798\uadf8\ub85c \ub108\ube44 \uc870\uc808, \uba38\ub9ac\uae00 \ub4dc\ub798\uadf8\ub85c \uc21c\uc11c \ubcc0\uacbd.</li> <li>\uc140 \ud3b8\uc9d1: \ud3b8\uc9d1 \uac00\ub2a5\ud55c \uc140\uc744 \ud074\ub9ad/\ub354\ube14\ud074\ub9ad\ud574 \uac12\uc744 \uc785\ub825(\ub4dc\ub86d\ub2e4\uc6b4\u00b7\ub0a0\uc9dc\u00b7\uc22b\uc790 \ub4f1 \uc140 \uc720\ud615\ubcc4 \uc785\ub825\uae30).</li> <li>\ud589 \ucd94\uac00/\uc0ad\uc81c: \ud654\uba74 \uc0c1\ub2e8/\ud45c \uc704\uc758 \ucd94\uac00\u00b7\uc0ad\uc81c \ubc84\ud2bc \uc0ac\uc6a9. \ud3b8\uc9d1\u00b7\ucd94\uac00\u00b7\uc0ad\uc81c\ud55c \ud589\uc740 \ud45c\uc2dc\uac00 \ubc14\ub00c\uba70 [\uc800\uc7a5] \uc2dc \ubc18\uc601\ub429\ub2c8\ub2e4.</li> </ul> <p>\uc800\uc7a5 \uc804 \uc774\ub3d9 \uc8fc\uc758</p> <p>\ud45c\uc5d0\uc11c \ud3b8\uc9d1\ud55c \ub0b4\uc6a9\uc740 [\uc800\uc7a5] \ud558\uae30 \uc804\uc5d0\ub294 \uc11c\ubc84\uc5d0 \ubc18\uc601\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc800\uc7a5 \uc5c6\uc774 \ub2e4\ub978 \ud0ed/\ud654\uba74\uc73c\ub85c \uc774\ub3d9\ud558\uba74 \uc0ac\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"common-ui/#_5","title":"\uc5d1\uc140","text":"<ul> <li>\uc5d1\uc140 \ub2e4\uc6b4\ub85c\ub4dc: \ud45c\uc758 \ud604\uc7ac \ub0b4\uc6a9\uc744 \uc5d1\uc140\ub85c \ub0b4\ub824\ubc1b\uc2b5\ub2c8\ub2e4.</li> <li>\uc77c\ubd80 \ud654\uba74\uc740 \uc5d1\uc140 \uc5c5\ub85c\ub4dc(\uc591\uc2dd\uc5d0 \ub9de\ucdb0 \ub300\ub7c9 \uc785\ub825)\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc81c\uacf5\ub418\ub294 \uc591\uc2dd\uc744 \ubc1b\uc544 \uc791\uc131 \ud6c4 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694.</li> </ul>"},{"location":"common-ui/#_6","title":"\ud30c\uc77c \ucca8\ubd80","text":"<ul> <li>\ud30c\uc77c \uc5c5\ub85c\ub4dc \uc601\uc5ed\uc5d0 \ud30c\uc77c\uc744 \uc120\ud0dd/\ub04c\uc5b4\ub2e4 \ub193\uc544 \ucca8\ubd80\ud569\ub2c8\ub2e4.</li> <li>\ucca8\ubd80 \ubaa9\ub85d\uc5d0\uc11c \ud30c\uc77c\uc744 \ub0b4\ub824\ubc1b\uac70\ub098 \uc0ad\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"common-ui/#_7","title":"\ud31d\uc5c5 \ud654\uba74","text":"<p>\uc0c1\uc138 \uc870\ud68c\u00b7\uc120\ud0dd(\uace0\uac1d \ucf54\ub4dc \uac80\uc0c9, \uc774\ubbf8\uc9c0 \ubdf0\uc5b4, \uc774\uba54\uc77c \ubc1c\uc1a1 \ub4f1)\uc740 \ubcc4\ub3c4 \ud31d\uc5c5\uc73c\ub85c \uc5f4\ub9bd\ub2c8\ub2e4. \ud31d\uc5c5\uc5d0\uc11c \uc120\ud0dd/\ud655\uc778\ud558\uba74 \uc6d0\ub798 \ud654\uba74\uc73c\ub85c \uac12\uc774 \uc804\ub2ec\ub429\ub2c8\ub2e4.</p>"},{"location":"common-ui/#_8","title":"\ub85c\ub529 \ud45c\uc2dc","text":"<p>\uc870\ud68c\u00b7\uc800\uc7a5 \uc911\uc5d0\ub294 \ub85c\ub529 \ud45c\uc2dc\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \uac19\uc740 \ubc84\ud2bc\uc744 \uc5ec\ub7ec \ubc88 \ub204\ub974\uc9c0 \ub9c8\uc138\uc694.</p>"},{"location":"faq/","title":"\uc790\uc8fc \ubb3b\ub294 \uc9c8\ubb38","text":""},{"location":"faq/#_2","title":"\ub85c\uadf8\uc778 / \uc811\uc18d","text":"<p>Q. \ub85c\uadf8\uc778 \ud654\uba74\uc73c\ub85c \uc790\uafb8 \ub3cc\uc544\uac11\ub2c8\ub2e4. \uc138\uc158\uc774 \ub9cc\ub8cc\ub41c \uac83\uc785\ub2c8\ub2e4. \ub2e4\uc2dc \ub85c\uadf8\uc778\ud558\uc138\uc694. \uc800\uc7a5\ud558\uc9c0 \uc54a\uc740 \uc785\ub825\uc740 \uc720\uc9c0\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <p>Q. \uba54\ub274\uac00 \ubcf4\uc774\uc9c0 \uc54a\uac70\ub098 \ud654\uba74\uc5d0 \ub4e4\uc5b4\uac08 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uba54\ub274/\ud654\uba74 \uc811\uadfc\uc740 \uad8c\ud55c\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \ud544\uc694\ud55c \uba54\ub274\uac00 \uc5c6\uc73c\uba74 \uad00\ub9ac\uc790\uc5d0\uac8c \uad8c\ud55c\uc744 \uc694\uccad\ud558\uc138\uc694.</p>"},{"location":"faq/#_3","title":"\uc870\ud68c","text":"<p>Q. \uc870\ud68c\ud588\ub294\ub370 \uacb0\uacfc\uac00 \ube44\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uc744 \ud655\uc778\ud558\uc138\uc694. \u2460 \uc0c1\ub2e8\uc758 \ud68c\uc0ac/\uace0\uac1d(\ucee8\ud14d\uc2a4\ud2b8) \uc120\ud0dd, \u2461 \uac80\uc0c9 \uae30\uac04/\uc870\uac74, \u2462 \uad8c\ud55c \ubc94\uc704.</p> <p>Q. \ub370\uc774\ud130\uac00 \uc608\uc0c1\uacfc \ub2e4\ub985\ub2c8\ub2e4. \ud604\uc7ac \uc120\ud0dd\ub41c \ud68c\uc0ac\u00b7\uace0\uac1d\u00b7\uc704\uce58 \ucee8\ud14d\uc2a4\ud2b8\ub97c \uba3c\uc800 \ud655\uc778\ud558\uc138\uc694. \ub9c8\uc2a4\ud130 \ub370\uc774\ud130(\uc694\uc728/\ucf54\ub4dc)\uac00 \ucd5c\uadfc \ubcc0\uacbd\ub410\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"faq/#_4","title":"\ud3b8\uc9d1 / \uc800\uc7a5","text":"<p>Q. \ud45c\uc5d0\uc11c \uc218\uc815\ud588\ub294\ub370 \ubc18\uc601\uc774 \uc548 \ub429\ub2c8\ub2e4. \ud45c \ud3b8\uc9d1 \ub0b4\uc6a9\uc740 [\uc800\uc7a5] \uc744 \ub20c\ub7ec\uc57c \uc11c\ubc84\uc5d0 \ubc18\uc601\ub429\ub2c8\ub2e4. \uc800\uc7a5 \uc804 \ub2e4\ub978 \ud654\uba74\uc73c\ub85c \uc774\ub3d9\ud558\uba74 \uc0ac\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <p>Q. \uc800\uc7a5/\ubc1c\ud589\uc774 \uc2e4\ud328\ud569\ub2c8\ub2e4. \ud654\uba74\uc5d0 \ud45c\uc2dc\ub418\ub294 \uc624\ub958 \uba54\uc2dc\uc9c0\ub97c \ud655\uc778\ud558\uc138\uc694. \uc678\ubd80 \uc5f0\ub3d9(EIR \ubc1c\ud589 \ub4f1)\uc740 \ud574\ub2f9 \ubaa8\ub4c8\uc758 \uc751\ub2f5 \ub85c\uadf8\uc5d0\uc11c \uc6d0\uc778\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"faq/#_5","title":"\uc5d1\uc140 / \ud30c\uc77c","text":"<p>Q. \uc5d1\uc140 \uc5c5\ub85c\ub4dc\uac00 \uc548 \ub429\ub2c8\ub2e4. \uc81c\uacf5\ub41c \uc591\uc2dd\uc744 \uc0ac\uc6a9\ud588\ub294\uc9c0, \ud544\uc218 \ud56d\ubaa9\uc774 \ucc44\uc6cc\uc84c\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc591\uc2dd \uc678 \uceec\ub7fc/\ud615\uc2dd\uc740 \uc778\uc2dd\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"faq/#_6","title":"\uae30\ud0c0","text":"<p>Q. \ud654\uba74\uc774 \ub290\ub9ac\uac70\ub098 \uba48\ucd98 \uac83 \uac19\uc2b5\ub2c8\ub2e4. \uc870\ud68c/\uc800\uc7a5 \uc911\uc5d0\ub294 \ub85c\ub529 \ud45c\uc2dc\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \uac19\uc740 \ubc84\ud2bc\uc744 \ubc18\ubcf5\ud574\uc11c \ub204\ub974\uc9c0 \ub9c8\uc138\uc694.</p> <p>\uc5ec\uae30\uc11c \ud574\uacb0\ub418\uc9c0 \uc54a\ub294 \ubb38\uc81c\ub294 \uc2dc\uc2a4\ud15c \uad00\ub9ac\uc790 \ub610\ub294 \ub2f4\ub2f9 \ubd80\uc11c\uc5d0 \ubb38\uc758\ud558\uc138\uc694.</p>"},{"location":"getting-started/","title":"\uc2dc\uc791\ud558\uae30","text":""},{"location":"getting-started/#_2","title":"\ub85c\uadf8\uc778","text":"<ol> <li>\ud3ec\ud138 \uc8fc\uc18c\ub85c \uc811\uc18d\ud558\uba74 \ub85c\uadf8\uc778 \ud654\uba74\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4.</li> <li>\uc0ac\ubc88(USER ID) \uacfc \ube44\ubc00\ubc88\ud638\ub97c \uc785\ub825\ud558\uace0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4.</li> <li>\ub85c\uadf8\uc778\uc5d0 \uc131\uacf5\ud558\uba74 \uc5c5\ubb34 \ud654\uba74\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc77c\uc815 \uc2dc\uac04 \ubbf8\uc0ac\uc6a9 \uc2dc \uc790\ub3d9\uc73c\ub85c \ub85c\uadf8\uc544\uc6c3\ub418\uba70, \uc774\ub54c\ub294 \ub2e4\uc2dc \ub85c\uadf8\uc778\ud558\uba74 \ub429\ub2c8\ub2e4.</li> </ol> <p>\ub85c\uadf8\uc778\uc774 \ud480\ub9b4 \ub54c</p> <p>\ud654\uba74 \uc870\uc791 \uc911 \uac11\uc790\uae30 \ub85c\uadf8\uc778 \ud654\uba74\uc73c\ub85c \ub3cc\uc544\uac00\uba74 \uc138\uc158\uc774 \ub9cc\ub8cc\ub41c \uac83\uc785\ub2c8\ub2e4. \ub2e4\uc2dc \ub85c\uadf8\uc778 \ud6c4 \uc774\uc5b4\uc11c \uc791\uc5c5\ud558\uc138\uc694(\uc791\uc131 \uc911\uc774\ub358 \ub0b4\uc6a9\uc740 \uc800\uc7a5 \uc804\uc774\ub77c\uba74 \uc720\uc9c0\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4).</p>"},{"location":"getting-started/#_3","title":"\ud654\uba74 \uad6c\uc131","text":"<p>\ub85c\uadf8\uc778 \ud6c4 \ud654\uba74\uc740 \uc138 \uc601\uc5ed\uc73c\ub85c \ub098\ub269\ub2c8\ub2e4.</p> <pre><code>\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\n\u2502  \uc0c1\ub2e8\ubc14 (\ub85c\uace0 \u00b7 \ud68c\uc0ac/\uc0ac\uc6a9\uc790 \u00b7 \uc5b8\uc5b4)              \u2502  \u2190 \ud5e4\ub354\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502           \u2502  [\ud0ed1] [\ud0ed2] [\ud0ed3] ...             \u2502  \u2190 \uc5f4\ub9b0 \ud654\uba74 \ud0ed\n\u2502  \uc88c\uce21     \u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502  \uba54\ub274     \u2502                                  \u2502\n\u2502  (\ud2b8\ub9ac)   \u2502   \ud654\uba74 \ub0b4\uc6a9 (\uac80\uc0c9\uc870\uac74 + \ud45c)        \u2502\n\u2502           \u2502                                  \u2502\n\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\n</code></pre> <ul> <li>\uc0c1\ub2e8\ubc14 \u2014 \ub85c\uace0, \ud604\uc7ac \ud68c\uc0ac/\uc0ac\uc6a9\uc790, \uc5b8\uc5b4 \uc804\ud658.</li> <li>\uc88c\uce21 \uba54\ub274 \u2014 \uc5c5\ubb34 \uba54\ub274 \ud2b8\ub9ac. \uc811\uae30/\ud3b4\uae30\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4.</li> <li>\ud0ed \uc601\uc5ed \u2014 \uc120\ud0dd\ud55c \ud654\uba74\uc774 \ud0ed\uc73c\ub85c \uc5f4\ub9bd\ub2c8\ub2e4(\uc5ec\ub7ec \ud654\uba74 \ub3d9\uc2dc \uc791\uc5c5).</li> </ul>"},{"location":"getting-started/#_4","title":"\uba54\ub274 / \ud0ed \uc0ac\uc6a9","text":"<ul> <li>\uc88c\uce21 \uba54\ub274\uc5d0\uc11c \ud56d\ubaa9\uc744 \ud074\ub9ad\ud558\uba74 \ud574\ub2f9 \ud654\uba74\uc774 \uc0c8 \ud0ed\uc73c\ub85c \uc5f4\ub9bd\ub2c8\ub2e4.</li> <li>\uc774\ubbf8 \uc5f4\ub824 \uc788\ub294 \ud654\uba74\uc740 \uadf8 \ud0ed\uc73c\ub85c \uc804\ud658\ub429\ub2c8\ub2e4.</li> <li>\ud0ed\uc744 \ub2eb\uc73c\ub824\uba74 \ud0ed\uc758 \ub2eb\uae30(\u00d7)\ub97c \ub204\ub985\ub2c8\ub2e4.</li> <li>\uac19\uc740 \ud654\uba74\uc744 \uc5ec\ub7ec \ubc8c \uc5f4\uc5b4 \ube44\uad50 \uc791\uc5c5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4(\ubcf5\uc81c \ud0ed).</li> </ul>"},{"location":"getting-started/#_5","title":"\ud68c\uc0ac / \uace0\uac1d \ucee8\ud14d\uc2a4\ud2b8","text":"<p>\uc0c1\ub2e8\uc758 \ud68c\uc0ac(\ubc95\uc778) \uc120\ud0dd\uc740 \ud654\uba74 \uc870\ud68c \ubc94\uc704\uc5d0 \uc601\ud5a5\uc744 \uc90d\ub2c8\ub2e4. \ub370\uc774\ud130\uac00 \uc608\uc0c1\uacfc \ub2e4\ub974\uba74 \ud604\uc7ac \uc120\ud0dd\ub41c \ud68c\uc0ac/\uace0\uac1d\uc774 \ub9de\ub294\uc9c0 \uba3c\uc800 \ud655\uc778\ud558\uc138\uc694.</p>"},{"location":"getting-started/#_6","title":"\ub2e4\uc74c \ub2e8\uacc4","text":"<p>\ubaa8\ub4e0 \ud654\uba74\uc5d0 \uacf5\ud1b5\uc778 \uc870\ud68c\u00b7\uadf8\ub9ac\ub4dc\u00b7\uc5d1\uc140\u00b7\ud30c\uc77c \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95\uc5d0\uc11c \ud55c \ubc88\uc5d0 \uc775\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"modules/","title":"\uc5c5\ubb34 \uba54\ub274 \uac1c\uc694","text":"<p>Vendor Portal V2 \uc758 \uc5c5\ubb34 \ud654\uba74\uc740 \uc544\ub798 \ubaa8\ub4c8\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ubaa8\ub4c8\uba85\u00b7\uba54\ub274 \uad6c\uc131\uc740 \uad8c\ud55c\uc5d0 \ub530\ub77c \ub2e4\ub97c \uc218 \uc788\uc73c\uba70, \uc815\ud655\ud55c \uba85\uce6d\uc740 \ub85c\uadf8\uc778 \ud6c4 \uc88c\uce21 \uba54\ub274\uac00 \uae30\uc900\uc785\ub2c8\ub2e4.</p> \ubaa8\ub4c8 \uc57d\uc5b4 \ub2e4\ub8e8\ub294 \uc5c5\ubb34 EIR \ubc1c\ud589 <code>eir</code> \uc218\ucd9c\uc785 \ucee8\ud14c\uc774\ub108 EIR(\uae30\uae30\uc218\ub3c4\uc99d) \ubc1c\ud589\u00b7\ud604\ud669\u00b7\uc751\ub2f5\ub85c\uadf8 \ucee8\ud14c\uc774\ub108 \uc218\ub9ac (CRS) <code>crs</code> \ucee8\ud14c\uc774\ub108 \uc218\ub9ac \uacac\uc801/\uc2b9\uc778/\uac80\uc0ac/\uc774\ub825\u00b7\uccad\uad6c \ud130\ubbf8\ub110 \ube44\uc6a9 \uc815\uc0b0 (TES) <code>tes</code> \uc608\uc120\u00b7\ub77c\uc2f1\u00b7\ub77c\uc778\ud578\ub4e4\ub9c1\u00b7\uac80\uc218 \ube44\uc6a9 \ubc0f \uc778\ubcf4\uc774\uc2a4 \uc815\uc0b0 \uc778\ub79c\ub4dc \ud53c\ub354 \uc6b4\uc1a1 (FDS) <code>fds</code> \uc624\ub354 \uc0dd\uc131\u00b7\uc778\ubcf4\uc774\uc2a4\u00b7\uc694\uc728\u00b7\ub514\uba38\ub9ac\uc9c0 \ucee8\ud14c\uc774\ub108 \uc774\ub3d9\u00b7\uc7ac\uace0 (MVS) <code>mvs</code> \uc7ac\uace0\ud604\ud669\u00b7\ubc18\ub0a9\u00b7\uc774\ub3d9 CFS \uc791\uc5c5 <code>cfs</code> CFS(\ubcf4\uc138\ucc3d\uace0) \uc801\uc785\u00b7\uc791\uc5c5\uc774\ub825\u00b7\uc218\ub9ac\uc774\ub825 <p>Tip</p> <p>\ubaa8\ub4e0 \ubaa8\ub4c8 \ud654\uba74\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95\uc758 \uc870\ud68c\u2192\ud3b8\uc9d1\u2192\uc800\uc7a5 \ud750\ub984\uc744 \uacf5\uc720\ud569\ub2c8\ub2e4. \uac01 \ubaa8\ub4c8 \ud398\uc774\uc9c0\ub294 \uadf8 \uc704\uc5d0 \uc5c5\ubb34\ubcc4 \ud2b9\uc774\uc0ac\ud56d\ub9cc \uc124\uba85\ud569\ub2c8\ub2e4.</p> <p>\uc77c\ubd80 \ubaa8\ub4c8\uba85(TES\u00b7MVS)\uc740 \uc5c5\ubb34 \uba85\uce6d \ud655\uc815\uc774 \ud544\uc694\ud55c \ud56d\ubaa9\uc785\ub2c8\ub2e4. \uc0ac\ub0b4 \ud655\uc815 \uba85\uce6d\uc774 \uc815\ud574\uc9c0\uba74 \ub9e4\ub274\uc5bc\uc744 \uc5c5\ub370\uc774\ud2b8\ud569\ub2c8\ub2e4.</p>"},{"location":"modules/cfs/","title":"CFS \uc791\uc5c5","text":"<p>CFS(Container Freight Station, \ubcf4\uc138\ucc3d\uace0)\uc758 \uc801\uc785\u00b7\uc791\uc5c5 \uc774\ub825\u00b7\uc218\ub9ac \uc774\ub825\uc744 \ub2e4\ub8f9\ub2c8\ub2e4.</p>"},{"location":"modules/cfs/#_1","title":"\ud654\uba74 \uad6c\uc131","text":"\ud654\uba74 \ud558\ub294 \uc77c \uc791\uc5c5 \uc774\ub825 (CfsWorkHistory) CFS \uc791\uc5c5 \ub0b4\uc5ed \uc870\ud68c \uc154\ud2c0 \uc774\ub825 (CfsShuttleHistory) \uc154\ud2c0(\uc6b4\uc1a1) \uc774\ub825 \uc870\ud68c \uc801\uc785 \ube44\uc6a9 (CfsStuffExpn) \uc801\uc785(Stuffing) \ube44\uc6a9 \ub4f1\ub85d/\uc870\ud68c \uc801\uc785 \uc778\ubcf4\uc774\uc2a4 (CfsStuffInvoice) \uc801\uc785 \ube44\uc6a9 \uccad\uad6c(\uc778\ubcf4\uc774\uc2a4) \ubc18\ub0a9 \uc218\ub9ac \uc774\ub825 (CfsRtnRepairHistory) \ubc18\ub0a9 \uc2dc \uc218\ub9ac \uc774\ub825 \uc870\ud68c"},{"location":"modules/cfs/#_2","title":"\uc77c\ubc18 \ud750\ub984","text":"<ol> <li>CFS \uc791\uc5c5(\uc801\uc785 \ub4f1) \ubc1c\uc0dd \uc2dc \uc791\uc5c5 \uc774\ub825 / \uc801\uc785 \ube44\uc6a9\uc5d0 \uae30\ub85d.</li> <li>\uc801\uc785 \uc778\ubcf4\uc774\uc2a4\ub85c \ube44\uc6a9\uc744 \uccad\uad6c\ud558\uace0, \ubc18\ub0a9/\uc218\ub9ac\ub294 \uad00\ub828 \uc774\ub825 \ud654\uba74\uc5d0\uc11c \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ol> <p>\uacf5\ud1b5 \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95 \ucc38\uace0.</p>"},{"location":"modules/crs/","title":"\ucee8\ud14c\uc774\ub108 \uc218\ub9ac (CRS)","text":"<p>\ucee8\ud14c\uc774\ub108(\uc6a9\uae30) \uc218\ub9ac \uc5c5\ubb34 \u2014 \uacac\uc801\u00b7\uc2b9\uc778\u00b7\uac80\uc0ac\u00b7\uc774\ub825\u00b7\uccad\uad6c\ub97c \ub2e4\ub8f9\ub2c8\ub2e4.</p>"},{"location":"modules/crs/#_1","title":"\ud654\uba74 \uad6c\uc131","text":"\ud654\uba74 \ud558\ub294 \uc77c \uc218\ub9ac \uc774\ub825 (CrsRepairHistory) \ucee8\ud14c\uc774\ub108\ubcc4 \uc218\ub9ac \uc774\ub825 \uc870\ud68c \uc218\ub9ac \ucf54\ub4dc (CrsRepairCode) \uc218\ub9ac \ud56d\ubaa9/\ucf54\ub4dc \uad00\ub9ac \uacac\uc801 (CrsEstimate) / \uacac\uc801 \uc2b9\uc778 (CrsEstApproval) \uc218\ub9ac \uacac\uc801 \uc791\uc131\u00b7\uc2b9\uc778 \uacac\uc801 \uc5d1\uc140 \uc5c5\ub85c\ub4dc (CrsEstUploadExl) \uacac\uc801 \ub300\ub7c9 \uc5c5\ub85c\ub4dc \uac80\uc0ac (CrsConstExam) \uc218\ub9ac \uac80\uc0ac(\uac80\uc218) \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 (CrsCntrMove) \uc218\ub9ac \uad00\ub828 \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 \ube44\uc6a9 \ucc28\ud2b8 (CrsExpnChart) \uc218\ub9ac \ube44\uc6a9 \ud1b5\uacc4/\ucc28\ud2b8 \uc778\ubcf4\uc774\uc2a4 (CrsInvoice) \uc218\ub9ac \ube44\uc6a9 \uccad\uad6c(\uc778\ubcf4\uc774\uc2a4)"},{"location":"modules/crs/#_2","title":"\uc77c\ubc18 \ud750\ub984","text":"<ol> <li>\uc218\ub9ac\uac00 \ud544\uc694\ud55c \ucee8\ud14c\uc774\ub108\uc5d0 \ub300\ud574 \uacac\uc801 \uc791\uc131 \u2192 \uacac\uc801 \uc2b9\uc778.</li> <li>\uc791\uc5c5 \ud6c4 \uac80\uc0ac\ub85c \uacb0\uacfc \ud655\uc778, \uc218\ub9ac \uc774\ub825\uc5d0 \uae30\ub85d.</li> <li>\uc778\ubcf4\uc774\uc2a4\ub85c \ube44\uc6a9\uc744 \uccad\uad6c\ud558\uace0, \ube44\uc6a9 \ucc28\ud2b8\ub85c \uc9d1\uacc4\ub97c \ubd05\ub2c8\ub2e4.</li> </ol> <p>\uc138\ubd80 \uc870\ud68c\u00b7\ud45c\u00b7\uc5d1\uc140 \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95 \ucc38\uace0. \uacac\uc801/\uc778\ubcf4\uc774\uc2a4 \ud31d\uc5c5\uc5d0\uc11c \uc0c1\uc138\ub97c \ud655\uc778\u00b7\ud3b8\uc9d1\ud569\ub2c8\ub2e4.</p>"},{"location":"modules/eir/","title":"EIR \ubc1c\ud589","text":"<p>\uc218\ucd9c\uc785 \ucee8\ud14c\uc774\ub108\uc758 EIR(Equipment Interchange Receipt, \uae30\uae30\uc218\ub3c4\uc99d) \ubc1c\ud589\uacfc \ud604\ud669\uc744 \ub2e4\ub8f9\ub2c8\ub2e4.</p>"},{"location":"modules/eir/#_1","title":"\ud654\uba74 \uad6c\uc131","text":"\ud654\uba74 \ud558\ub294 \uc77c \uc218\ucd9c EIR \ubc1c\ud589 (EirExportIssue) \uc218\ucd9c \ubd80\ud0b9 \uae30\uc900\uc73c\ub85c \ucee8\ud14c\uc774\ub108\ub97c \uc870\ud68c\ud574 EIR \uc744 \ubc1c\ud589 \uc218\uc785 EIR \ubc1c\ud589 (EirImportIssue) \uc218\uc785 \uac74 \uae30\uc900 EIR \ubc1c\ud589 EIR \ubc1c\ud589 \ud604\ud669 (EirIssueStatus) \ubc1c\ud589\ub41c EIR \uc758 \uc0c1\ud0dc/\uc774\ub825 \uc870\ud68c \uc751\ub2f5 \ub85c\uadf8 (EirResponseLog) \uc678\ubd80 \uc2dc\uc2a4\ud15c(\ud130\ubbf8\ub110/SIPG \ub4f1) \uc5f0\ub3d9 \uc751\ub2f5 \ub85c\uadf8 DEM \ubaa9\ub85d (EirDemList) \ub514\uba38\ub9ac\uc9c0(\uccb4\ud654\ub8cc) \uad00\ub828 \ubaa9\ub85d \uc870\ud68c <p>\uc815\ud655\ud55c \uba54\ub274\uba85\uc740 \uad8c\ud55c\uc5d0 \ub530\ub77c \ub2e4\ub97c \uc218 \uc788\uc73c\uba70 \uc88c\uce21 \uba54\ub274\uac00 \uae30\uc900\uc785\ub2c8\ub2e4.</p>"},{"location":"modules/eir/#eir_1","title":"\uc218\ucd9c EIR \ubc1c\ud589 \ud750\ub984","text":"<ol> <li>\uac80\uc0c9 \uc870\uac74 \uc785\ub825 \u2014 \uae30\uac04, \ubd80\ud0b9\ubc88\ud638(B/L No.) \ub4f1 \uc870\uac74\uc744 \ub123\uace0 [\uc870\ud68c].</li> <li>\ub300\uc0c1 \ucee8\ud14c\uc774\ub108 \ud655\uc778 \u2014 \ud45c\uc5d0 \uc870\ud68c\ub41c \ucee8\ud14c\uc774\ub108 \ubaa9\ub85d\uc5d0\uc11c \ubc1c\ud589\ud560 \ud589\uc744 \uc120\ud0dd(\uccb4\ud06c).</li> <li>[\ubc1c\ud589] \u2014 \uc120\ud0dd\ud55c \uac74\uc758 EIR \uc744 \ubc1c\ud589\ud569\ub2c8\ub2e4. \ubc1c\ud589 \uacb0\uacfc/\uc0c1\ud0dc\uac00 \ud45c\uc5d0 \uac31\uc2e0\ub429\ub2c8\ub2e4.</li> <li>\ubc1c\ud589 \ud6c4\uc5d0\ub294 EIR \ubc1c\ud589 \ud604\ud669\uc5d0\uc11c \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\uace0, \uc678\ubd80 \uc5f0\ub3d9 \uacb0\uacfc\ub294 \uc751\ub2f5 \ub85c\uadf8\uc5d0\uc11c \uc810\uac80\ud569\ub2c8\ub2e4.</li> </ol> <p>\ubc1c\ud589 \uc804 \uc810\uac80</p> <p>\ubc1c\ud589 \ub300\uc0c1\uc758 \ucee8\ud14c\uc774\ub108 \ubc88\ud638\u00b7\ubd80\ud0b9 \uc815\ubcf4\uac00 \ub9de\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ubc1c\ud589\uc740 \uc678\ubd80 \uc2dc\uc2a4\ud15c\uc73c\ub85c \uc804\uc1a1\ub418\ubbc0\ub85c, \uc798\ubabb \ubc1c\ud589\ud55c \uacbd\uc6b0 \uc815\ud574\uc9c4 \ucde8\uc18c/\uc815\uc815 \uc808\ucc28(\uc751\ub2f5 \ub85c\uadf8 \ud655\uc778)\ub97c \ub530\ub985\ub2c8\ub2e4.</p>"},{"location":"modules/eir/#_2","title":"\uc790\uc8fc \ubcf4\ub294 \uc0c1\ud669","text":"<ul> <li>\uc870\ud68c \uacb0\uacfc\uac00 \ube44\uc5b4 \uc788\uc74c \u2014 \uc0c1\ub2e8\uc758 \ud68c\uc0ac/\uace0\uac1d \ucee8\ud14d\uc2a4\ud2b8\uc640 \uac80\uc0c9 \uae30\uac04\uc744 \ud655\uc778\ud558\uc138\uc694.</li> <li>\ubc1c\ud589\uc774 \uc2e4\ud328\ud568 \u2014 \uc751\ub2f5 \ub85c\uadf8(EirResponseLog)\uc5d0\uc11c \uc678\ubd80 \uc2dc\uc2a4\ud15c \uc751\ub2f5 \uba54\uc2dc\uc9c0\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ul> <p>\uc870\ud68c\u00b7\ud45c\u00b7\uc5d1\uc140\u00b7\ud30c\uc77c \ub4f1 \uacf5\ud1b5 \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95\uc744 \ucc38\uace0\ud558\uc138\uc694.</p>"},{"location":"modules/fds/","title":"\uc778\ub79c\ub4dc \ud53c\ub354 \uc6b4\uc1a1 (FDS)","text":"<p>\uc624\ub354 \uc0dd\uc131\ubd80\ud130 \uc778\ubcf4\uc774\uc2a4\u00b7\uc694\uc728\u00b7\ub514\uba38\ub9ac\uc9c0\uae4c\uc9c0 \uccad\uad6c/\uc815\uc0b0 \uc5c5\ubb34\ub97c \ub2e4\ub8f9\ub2c8\ub2e4.</p>"},{"location":"modules/fds/#_1","title":"\ud654\uba74 \uad6c\uc131","text":"\ud654\uba74 \ud558\ub294 \uc77c \uc624\ub354 \uc0dd\uc131 (FdsOrdCreate) / \uc624\ub354 \uad00\ub9ac (FdsOrdMgt) \uc624\ub354 \ub4f1\ub85d\u00b7\uad00\ub9ac \uc778\ubcf4\uc774\uc2a4 (FdsInvoice) \uc778\ubcf4\uc774\uc2a4 \uc791\uc131/\uc870\ud68c \uc694\uc728 - \ud56d\ub9cc (FdsTariffPort) \ud56d\ub9cc \uc694\uc728 \uad00\ub9ac \ud53c\ub354\ub9ac\uc9c0 \uad00\ub9ac (FdsFeederageMgt) \ud53c\ub354 \uc6b4\uc784 \uad00\ub9ac \uc774\ub3d9 \uac80\uc0ac (FdsMoveInspect) \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 \uac80\uc0ac \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 \uc5c5\ub85c\ub4dc (FdsCntrMoveUpload) \uc774\ub3d9 \ub370\uc774\ud130 \ub300\ub7c9 \uc5c5\ub85c\ub4dc <ul> <li>\ubcf4\uc870 \ud31d\uc5c5: \uc624\ub354 \ub85c\uadf8(FdsOrderLogPopup), \ucee8\ud14c\uc774\ub108\ubcc4 \uc624\ub354 \uad00\ub9ac(FdsOrderMgtByCntrPopup), \uc778\ubcf4\uc774\uc2a4 \uc694\uc57d(FdsInvoiceSummaryPopup), \ub514\uba38\ub9ac\uc9c0 \uc0c1\uc138(FdsDemDetailPopup), \uc218\ub9ac \uc0c1\uc138(FdsRepairDetailPopup), \uc120\ubc15(FdsVslPopup) \ub4f1.</li> </ul>"},{"location":"modules/fds/#_2","title":"\uc77c\ubc18 \ud750\ub984","text":"<ol> <li>\uc624\ub354 \uc0dd\uc131/\uad00\ub9ac\ub85c \uccad\uad6c \ub300\uc0c1 \uc624\ub354\ub97c \ub4f1\ub85d.</li> <li>\uc778\ubcf4\uc774\uc2a4\uc5d0\uc11c \ube44\uc6a9\uc744 \uc0b0\uc815\u00b7\ubc1c\ud589\ud558\uba70, \uc694\uc728(FdsTariffPort)\u00b7\ud53c\ub354\ub9ac\uc9c0 \uae30\uc900\uc744 \ucc38\uc870\ud569\ub2c8\ub2e4.</li> <li>\ub514\uba38\ub9ac\uc9c0/\uc218\ub9ac \ub4f1 \uc0c1\uc138\ub294 \ud31d\uc5c5\uc5d0\uc11c \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ol> <p>\uacf5\ud1b5 \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95 \ucc38\uace0.</p>"},{"location":"modules/mvs/","title":"\ucee8\ud14c\uc774\ub108 \uc774\ub3d9\u00b7\uc7ac\uace0 (MVS)","text":"<p>\ucee8\ud14c\uc774\ub108 \uc7ac\uace0 \ud604\ud669\uacfc \uc774\ub3d9\u00b7\ubc18\ub0a9\uc744 \ub2e4\ub8f9\ub2c8\ub2e4.</p> <p>\uc5c5\ubb34 \uba85\uce6d \ud655\uc778 \uc911</p> <p>\ubaa8\ub4c8 \uba85\uce6d(MVS)\uc740 \uc0ac\ub0b4 \ud655\uc815 \uba85\uce6d \ud655\uc778\uc774 \ud544\uc694\ud55c \ud56d\ubaa9\uc785\ub2c8\ub2e4.</p>"},{"location":"modules/mvs/#_1","title":"\ud654\uba74 \uad6c\uc131","text":"\ud654\uba74 \ud558\ub294 \uc77c \uc7ac\uace0 \ud604\ud669 (MvsStockStatus) \uc704\uce58/\uc720\ud615\ubcc4 \ucee8\ud14c\uc774\ub108 \uc7ac\uace0 \uc870\ud68c \ubc18\ub0a9 \ud604\ud669 (MvsRedeliveryStts) \ucee8\ud14c\uc774\ub108 \ubc18\ub0a9 \uc0c1\ud0dc \uc870\ud68c \ub4dc\ub86d\uc624\ud504 (MvsDropOff) \ub4dc\ub86d\uc624\ud504(\ubc18\ub0a9\uc9c0 \ubcc0\uacbd/\uc9c0\uc815) \ucc98\ub9ac \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 (MvsCntrMove) \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 \ub4f1\ub85d/\uc870\ud68c"},{"location":"modules/mvs/#_2","title":"\uc77c\ubc18 \ud750\ub984","text":"<ol> <li>\uc7ac\uace0 \ud604\ud669\uc73c\ub85c \ud604\uc7ac \ucee8\ud14c\uc774\ub108 \ubcf4\uc720/\uc704\uce58\ub97c \ud655\uc778.</li> <li>\uc774\ub3d9\u00b7\ubc18\ub0a9 \ubc1c\uc0dd \uc2dc \ucee8\ud14c\uc774\ub108 \uc774\ub3d9 / \ub4dc\ub86d\uc624\ud504 / \ubc18\ub0a9 \ud604\ud669 \ud654\uba74\uc5d0\uc11c \ucc98\ub9ac\u00b7\ucd94\uc801\ud569\ub2c8\ub2e4.</li> </ol> <p>\uacf5\ud1b5 \uc870\ud68c\u00b7\ud45c \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95 \ucc38\uace0.</p>"},{"location":"modules/tes/","title":"\ud130\ubbf8\ub110 \ube44\uc6a9 \uc815\uc0b0 (TES)","text":"<p>\ud130\ubbf8\ub110 \uc791\uc5c5 \uad00\ub828 \ube44\uc6a9 \u2014 \uc608\uc120(Tug)\u00b7\ub77c\uc2f1(Lashing)\u00b7\ub77c\uc778\ud578\ub4e4\ub9c1(Line Handling)\u00b7\uac80\uc218(Inspection) \uc758 \ube44\uc6a9 \ub4f1\ub85d\uacfc \uc778\ubcf4\uc774\uc2a4 \uc815\uc0b0\uc744 \ub2e4\ub8f9\ub2c8\ub2e4.</p> <p>\uc5c5\ubb34 \uba85\uce6d \ud655\uc778 \uc911</p> <p>\ubaa8\ub4c8 \uba85\uce6d(TES)\uc740 \uc0ac\ub0b4 \ud655\uc815 \uba85\uce6d \ud655\uc778\uc774 \ud544\uc694\ud55c \ud56d\ubaa9\uc785\ub2c8\ub2e4. \uba54\ub274\ub294 \ube44\uc6a9 \uc885\ub958\ubcc4 \ud654\uba74\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4.</p>"},{"location":"modules/tes/#_1","title":"\ud654\uba74 \uad6c\uc131","text":"\ube44\uc6a9 \uc885\ub958 \ube44\uc6a9 \ub4f1\ub85d \uc778\ubcf4\uc774\uc2a4 \uad00\ub9ac \uc608\uc120 (Tug) TesTugExpn TesTugExpnInvMgt \ub77c\uc2f1 (Lashing) TesLashingExpn TesLashingInvMgt \ub77c\uc778\ud578\ub4e4\ub9c1 TesLineHandleExpn TesLineHandleInvMgt \uac80\uc218 (Inspection) TesInspExpn \u2014 \ud1b5\ud569 \uc778\ubcf4\uc774\uc2a4 \u2014 TesInvMgt <ul> <li>\uc5d1\uc140 \uc5c5\ub85c\ub4dc \ud31d\uc5c5: \uac01 \ube44\uc6a9 \uc885\ub958\ubcc4\ub85c \ub300\ub7c9 \ub4f1\ub85d(TesTugExpnExcelUpload, TesLashExpnExcelUpload, TesInspExpnExcelUpload).</li> <li>\uadf8\ub8f9 \uc778\ubcf4\uc774\uc2a4 \uc124\uc815(SetGroupInvoice), \uc815\uc815(AmendPopup), CFS \ubcc0\uacbd \uc774\ub825(TesCfsChangeHistoryPopup) \ub4f1 \ubcf4\uc870 \ud31d\uc5c5.</li> </ul>"},{"location":"modules/tes/#_2","title":"\uc77c\ubc18 \ud750\ub984","text":"<ol> <li>\ube44\uc6a9 \uc885\ub958\ubcc4 \ube44\uc6a9 \ub4f1\ub85d \ud654\uba74\uc5d0\uc11c \uc791\uc5c5 \ube44\uc6a9\uc744 \uc785\ub825(\ub610\ub294 \uc5d1\uc140 \uc5c5\ub85c\ub4dc).</li> <li>\uc778\ubcf4\uc774\uc2a4 \uad00\ub9ac \ud654\uba74\uc5d0\uc11c \ube44\uc6a9\uc744 \uc778\ubcf4\uc774\uc2a4\ub85c \ubb36\uc5b4 \uc815\uc0b0\ud569\ub2c8\ub2e4(\ud544\uc694 \uc2dc \uadf8\ub8f9 \uc778\ubcf4\uc774\uc2a4).</li> <li>\uc815\uc815\uc774 \ud544\uc694\ud558\uba74 \uc815\uc815(Amend) \ud31d\uc5c5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.</li> </ol> <p>\uacf5\ud1b5 \uc870\ud68c\u00b7\ud45c\u00b7\uc5d1\uc140 \uc5c5\ub85c\ub4dc \uc870\uc791\uc740 \uacf5\ud1b5 \ud654\uba74 \uc0ac\uc6a9\ubc95 \ucc38\uace0.</p>"}]}